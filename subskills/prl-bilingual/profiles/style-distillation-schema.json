{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prl-style-observation-1",
  "title": "PRL figure style observation",
  "type": "object",
  "required": [
    "source",
    "features",
    "measurement_status",
    "evidence_level",
    "counterexamples",
    "limitations"
  ],
  "properties": {
    "source": {
      "type": "object",
      "required": ["figure_id", "doi", "page", "bbox_pt", "pdf_sha256"],
      "properties": {
        "figure_id": {"type": "string", "minLength": 1},
        "doi": {"type": "string", "minLength": 1},
        "page": {"type": ["integer", "null"], "minimum": 1},
        "bbox_pt": {"type": ["array", "null"], "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
        "pdf_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "image_sha256": {"type": ["string", "null"]},
        "caption": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "features": {"type": "object"},
    "measurement_status": {"type": "object"},
    "evidence_level": {
      "type": "string",
      "enum": [
        "official_requirement",
        "official_recommendation",
        "accepted_corpus_observation",
        "local_default",
        "local_design_rule",
        "insufficient_evidence"
      ]
    },
    "counterexamples": {"type": "array"},
    "limitations": {"type": "array"}
  },
  "additionalProperties": true
}
