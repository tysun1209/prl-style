{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "citations": {
      "type": "array"
    },
    "claims": {
      "items": {
        "properties": {
          "aggregation_level": {
            "minLength": 1,
            "type": "string"
          },
          "allowed_strengthening": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "allowed_verbs": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "audit_status": {
            "enum": [
              "pending",
              "contract_passed",
              "needs_evidence",
              "failed"
            ]
          },
          "causal_status": {
            "enum": [
              "not_tested",
              "association",
              "supported",
              "not_applicable"
            ]
          },
          "claim_type": {
            "enum": [
              "comparison",
              "interpretation",
              "mechanism",
              "numerical",
              "observation",
              "theory",
              "unknown"
            ]
          },
          "evidence_ids": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "evidence_level": {
            "enum": [
              "derivation",
              "mechanism_test",
              "nondiscriminating",
              "numerical",
              "observation",
              "unknown"
            ]
          },
          "forbidden_strengthening": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "hedge_reason": {
            "type": "string"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "protected_facts": {
            "items": {
              "required": [
                "id",
                "unit"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "protected_terms": {
            "items": {
              "required": [
                "id",
                "category",
                "forms"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "required_boundary": {
            "items": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "required": [
                    "id",
                    "forms"
                  ],
                  "type": "object"
                }
              ]
            },
            "type": "array"
          },
          "status": {
            "enum": [
              "supported",
              "open"
            ]
          },
          "supporting_artifacts": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "claim_type",
          "evidence_level",
          "status",
          "evidence_ids",
          "supporting_artifacts",
          "required_boundary",
          "protected_facts",
          "protected_terms",
          "allowed_verbs",
          "forbidden_strengthening",
          "aggregation_level",
          "causal_status",
          "hedge_reason",
          "audit_status"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "evidence": {
      "type": "array"
    },
    "figures": {
      "type": "array"
    },
    "schema_version": {
      "const": 3
    }
  },
  "required": [
    "schema_version",
    "claims",
    "evidence",
    "figures",
    "citations"
  ],
  "title": "PRL v3 claim-ledger extension",
  "type": "object"
}
